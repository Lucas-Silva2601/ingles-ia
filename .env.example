# ============================================
# LinguasIA - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================

# Configuração da API Ollama Cloud (obrigatória para os recursos de IA)
# Crie sua chave em: https://ollama.com → Settings → API Keys
OLLAMA_API_KEY=sua_chave_api_aqui

# Opcional: customização do cliente e da validação
# (valores abaixo são os padrões já usados pela aplicação)
#
# Também funciona com um Ollama LOCAL, sem chave:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL=https://ollama.com
# API_DEFAULT_MODEL=gemma4:31b-cloud
# API_MAX_TOKENS_EXPLANATION=200
# API_MAX_TOKENS_SENTENCES=4000
# API_TIMEOUT=30000
# MAX_TEXT_LENGTH=10000
# MIN_TEXT_LENGTH=1
# ALLOWED_LANGUAGES=en,es,it,fr,de,nl,pl,ru,id,pt-BR,ja
